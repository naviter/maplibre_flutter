+// MBL_SHARED_VK_INSTANCE (maplibre_flutter committed patch): one VkInstance per process.
+//
+// Creating an instance makes the Vulkan loader load and initialise every installed ICD
+// and implicit layer — measured at ~1.6 s on an Intel iGPU — and mbgl paid that for EVERY
+// map, so each new map view (e.g. each flight window) froze for well over a second. The
+// instance carries no per-map state: every backend still creates its own VkDevice, queues,
+// allocator and command pool, so sharing it needs no extra synchronisation (instance-level
+// calls are thread-safe; only vkDestroyInstance needs external sync, and we never destroy
+// it). It is created by the first backend under a mutex and deliberately leaked for the
+// process lifetime, together with a DynamicLoader that keeps the Vulkan loader library
+// pinned — so the handle stays valid even while no backend exists. A host can also create
+// it early on a background thread (by constructing and discarding a backend) so that even
+// the first map skips the cost.
+namespace {
+struct SharedVkInstance {
+    std::mutex mutex;
+    vk::Instance instance{};
+    DynamicLoader* pinnedLoader = nullptr;
+};
+SharedVkInstance& sharedVkInstance() {
+    static auto* shared = new SharedVkInstance(); // intentionally leaked (process lifetime)
+    return *shared;
+}
+} // namespace
+
 void RendererBackend::initInstance() {
+    auto& shared = sharedVkInstance();
+    std::lock_guard<std::mutex> lock(shared.mutex);
+    if (!shared.instance) {
+        createSharedInstance();
+        shared.pinnedLoader = new DynamicLoader(); // pins the loader library (leaked)
+        shared.instance = instance.release();      // the process owns it from now on
+    }
+    // Non-owning view: released (never destroyed) in destroyResources.
+    instance = vk::UniqueInstance(shared.instance);
+    usingSharedInstance = true;
+}
+
+void RendererBackend::createSharedInstance() {
