      "type": "symbol",
      "metadata": {},
      "source": "contours",
      "source-layer": "contour",
      "maxzoom": 12,
      "filter": [
        "all",
        ["==", "$type", "LineString"],
        ["in", "nth_line", 10, 5],
        [">", "height", 0]
      ],
      "layout": {
        "text-size": {"base": 1, "stops": [[15, 9.5], [20, 12]]},
        "text-allow-overlap": false,
        "symbol-avoid-edges": true,
        "text-ignore-placement": false,
        "symbol-placement": "line",
        "text-padding": 10,
        "text-rotation-alignment": "map",
