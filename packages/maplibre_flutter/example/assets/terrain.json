      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["==", "$type", "Polygon"],
      "layout": {"visibility": "visible"},
      "paint": {
        "fill-color": "rgba(57, 156, 221, 1)",
        "fill-opacity": {"stops": [[13, 1], [16, 0]]}
