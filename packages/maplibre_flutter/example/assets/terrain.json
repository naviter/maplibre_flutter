{
  "version": 8,
  "name": "Terrain",
  "sprite": "https://maps.seeyou.cloud/assets/sprites/basic",
  "glyphs": "https://maps.seeyou.cloud/assets/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "tiles": ["https://maps.seeyou.cloud/vector/data/planet/{z}/{x}/{y}.pbf"],
      "maxzoom": 14
    },
    "cupocket": {
      "type": "raster",
      "tiles": ["https://maps.seeyou.cloud/hgt/pocket/{z}/{x}/{y}@2x.jpg"],
      "tileSize": 512,
      "maxzoom": 11
    },
    "cupocket-hd-europe": {
      "type": "raster",
      "tiles": ["https://maps.seeyou.cloud/hgt/pocket/{z}/{x}/{y}@2x.jpg"],
      "tileSize": 512,
      "bounds": [-15, -32, 30, 72],
      "minzoom": 12,
      "maxzoom": 12
    },
    "contours": {
      "type": "vector",
      "tiles": [
        "https://maps.seeyou.cloud/hgt/contours/{z}/{x}/{y}.pbf"
      ],
      "minzoom": 9,
      "maxzoom": 11
    },
    "contours_z12": {
      "type": "vector",
      "tiles": [
        "https://maps.seeyou.cloud/hgt/contours/{z}/{x}/{y}.pbf?interval=50&simplify=0.0001"
      ],
      "minzoom": 11,
      "maxzoom": 11
    },
    "contours_z13": {
      "type": "vector",
      "tiles": [
        "https://maps.seeyou.cloud/hgt/contours/{z}/{x}/{y}.pbf?interval=20&simplify=0.00005"
      ],
      "minzoom": 11,
      "maxzoom": 11
    },
    "contours_z14": {
      "type": "vector",
      "tiles": [
        "https://maps.seeyou.cloud/hgt/contours/{z}/{x}/{y}.pbf?interval=10&simplify=0.00005"
      ],
      "minzoom": 11,
      "maxzoom": 11
    },
    "sat": {
      "type": "raster",
      "tiles": [
        "https://weather.seeyou.cloud/sat?provider=SkySight&x={x}&y={y}&z={z}&unix_time=-1"
      ],
      "maxzoom": 9
    },
    "hqd": {
      "type": "vector",
      "tiles": ["https://maps.seeyou.cloud/vector/data/hqd/{z}/{x}/{y}.pbf"],
      "minzoom": 4,
      "maxzoom": 11
    },
    "trails": {
      "type": "vector",
      "tiles": ["https://maps.seeyou.cloud/vector/data/trails/{z}/{x}/{y}.pbf"],
      "minzoom": 9,
      "maxzoom": 11
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {"background-color": "#ffffff"}
    },
    {
      "id": "cupocket",
      "type": "raster",
      "source": "cupocket",
      "layout": {"visibility": "visible"},
      "paint": {
        "raster-opacity": {"stops": [[11, 1], [16, 0]]},
        "raster-contrast": 0.2,
        "raster-brightness-min": 0
      }
    },
    {
      "id": "cupockethd",
      "type": "raster",
